{
  "expo": {
    "name": "NetworkLoop",
    "slug": "networkloop",
    "version": "1.0.0",
    "description": "A personal CRM for networking, recruiting, and interviews.",
    "orientation": "portrait",
    "icon": "./assets/branding/networkloop-icon.png",
    "scheme": "networkloop",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.fayadhkader.networkloop",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/branding/networkloop-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fayadhkader.networkloop",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#294A47",
        "foregroundImage": "./assets/branding/networkloop-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/networkloop-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#294A47",
          "image": "./assets/branding/networkloop-splash.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00cf1ef0-1724-463d-807b-4f1840ea66d0"
      }
    },
    "owner": "fayadhkader"
  }
}
